# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Ваш Telegram ID. Можно не заполнять: владелицей станет тот, кто первым напишет боту /start
OWNER_ID=

# Часовой пояс — по нему считаются «день», «ночь» и время в приложении
TZ=Europe/Moscow

# Адрес приложения (https). Пусто — бот сам поднимет бесплатный туннель Cloudflare (нужна программа cloudflared)
PUBLIC_URL=

# Когда присылать недельный отчёт: день (mon…sun) и время. По умолчанию — понедельник 9:00, за прошедшую неделю
WEEKLY_REPORT=mon 09:00

# Порт на этом компьютере (обычно менять не нужно)
PORT=8080
